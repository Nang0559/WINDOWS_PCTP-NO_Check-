<?xml version="1.0" encoding="utf-8"?>
<connectionStrings>
  <!-- ONE SQL Server declaration: edit B7R2_FCCdb only (server, catalog, login). -->
  <!-- SQLPROVIDER, SqlTableCreator and every repository read it. Do not commit real secrets. -->
  <!-- Runtime copy actually used: %ProgramData%\PCTP\PCTP.Database.config (see CONFIGURATION.md). -->
  <add name="B7R2_FCCdb" connectionString="Data Source=192.168.200.57;Initial Catalog=B7R2_FCC;Persist Security Info=True;User ID=sa;Password=fccbrv;Connect Timeout=30;Encrypt=False;TrustServerCertificate=True" providerName="System.Data.SqlClient" />

  <!-- Derived at start-up from B7R2_FCCdb (ReportConnectionAlias) - do not edit the host/login here. -->
  <!-- The name is fixed by the DevExpress report designers that bind to it. -->
  <add name="accfast\bravo.B7R2_FCC.dbo" connectionString="XpoProvider=MSSqlServer;data source=192.168.200.57;user id=sa;password=fccbrv;initial catalog=B7R2_FCC;Persist Security Info=true" />
</connectionStrings>
