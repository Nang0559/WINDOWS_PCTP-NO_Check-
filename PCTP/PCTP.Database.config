<?xml version="1.0" encoding="utf-8"?>
<appSettings>
  <!--
    Edit this file beside PCTP.exe to switch database servers/catalogs.
    B7R2_FCCdb and B7R2_FCCdbb are legacy names and may intentionally share
    the same connection string. Do not commit real passwords to source control.
  -->
  <add key="B7R2_FCCdb"
       value="Data Source=192.168.200.57;Initial Catalog=B7R2_FCC;Persist Security Info=True;User ID=YOUR_SQL_USER;Password=YOUR_SQL_PASSWORD;Connect Timeout=30;Encrypt=False;TrustServerCertificate=True" />
  <add key="B7R2_FCCdbb"
       value="Data Source=192.168.200.57;Initial Catalog=B7R2_FCC;Persist Security Info=True;User ID=YOUR_SQL_USER;Password=YOUR_SQL_PASSWORD;Connect Timeout=30;Encrypt=False;TrustServerCertificate=True" />
</appSettings>
