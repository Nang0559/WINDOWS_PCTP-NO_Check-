<?xml version="1.0" encoding="utf-8"?>
<connectionStrings>
  <!-- ONE SQL Server declaration: edit B7R2_FCCdb only (server, catalog, login). -->
  <!-- SQLPROVIDER, SqlTableCreator and every repository read it. Do not commit real secrets. -->
  <!-- Runtime copy actually used: %ProgramData%\PCTP\PCTP.Database.config (see CONFIGURATION.md). -->
  <add name="B7R2_FCCdb" connectionString="Data Source=YOUR_SQL_SERVER;Initial Catalog=B7R2_FCC;Persist Security Info=True;User ID=YOUR_SQL_USER;Password=YOUR_SQL_PASSWORD;Connect Timeout=30;Encrypt=False;TrustServerCertificate=True" providerName="System.Data.SqlClient" />

  <!-- Derived at start-up from B7R2_FCCdb (ReportConnectionAlias) - do not edit the host/login here. -->
  <!-- The name is fixed by the DevExpress report designers that bind to it. -->
  <add name="accfast\bravo.B7R2_FCC.dbo" connectionString="XpoProvider=MSSqlServer;data source=YOUR_SQL_SERVER;user id=YOUR_SQL_USER;password=YOUR_SQL_PASSWORD;initial catalog=B7R2_FCC;Persist Security Info=true" />
  <!-- YOUR_SQL_CONFIG_TEMPLATE: replace these placeholders in the protected runtime config. -->
  <add name="IFS_ORACLE" connectionString="Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=YOUR_IFS_HOST)(PORT=1521))(CONNECT_DATA=(SERVER=DEDICATED)(SERVICE_NAME=fccprod)));User Id=YOUR_IFS_USER;Password=YOUR_IFS_PASSWORD;" providerName="Oracle.ManagedDataAccess.Client" />
  <add name="FVN_PCTP" connectionString="Data Source=YOUR_SQL_SERVER;Initial Catalog=FVN_PCTP;Persist Security Info=True;User ID=YOUR_SQL_USER;Password=YOUR_SQL_PASSWORD;Connect Timeout=30;Encrypt=False;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
</connectionStrings>
