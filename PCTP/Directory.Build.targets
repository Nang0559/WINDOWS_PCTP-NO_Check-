<Project>
  <ItemGroup>
    <!--
      Source-file inclusion is owned by the legacy PCTP.csproj.
      Do not add <Compile Include="..." /> entries here, otherwise the
      same .cs files can be evaluated more than once by MSBuild.
    -->
    <Compile Remove="Modules\KhoVatLy\FormStockHistory.cs" />
    <Compile Remove="Modules\KhoVatLy\FormStockHistory.Designer.cs" />
    <Compile Remove="Modules\KhoVatLy\FormInspectionHistory.cs" />
    <Compile Remove="Modules\KhoVatLy\FormInspectionHistory.Designer.cs" />
  </ItemGroup>

  <PropertyGroup>
    <WarningLevel>4</WarningLevel>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <Target Name="ValidatePctpBuildBaseline" BeforeTargets="CoreCompile">
    <Error Condition="'$(TargetFrameworkVersion)' != 'v4.7.2'" Text="PCTP build baseline violation: TargetFrameworkVersion must remain v4.7.2 during the current migration." />
    <Error Condition="'$(LangVersion)' != '7.3'" Text="PCTP build baseline violation: LangVersion must remain 7.3 during the current migration." />
  </Target>
</Project>
