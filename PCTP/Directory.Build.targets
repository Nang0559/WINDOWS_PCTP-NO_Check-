<Project>
  <ItemGroup>
    <!-- GiaoHangKhach UI/application sources must be part of the legacy PCTP build graph. -->
    <Compile Include="Modules\GiaoHangKhach\Services\DocQRScanEngine.cs" />
    <Compile Include="Modules\GiaoHangKhach\Services\DocQRSessionState.cs" />
    <Compile Include="Modules\GiaoHangKhach\Services\DocQRTableResolver.cs" />
    <Compile Include="Presentation\Presenters\HVNPresenterContext.cs" />
    <Compile Include="Presentation\Presenters\PhieuPresenter.cs" />
    <Compile Include="Presentation\Presenters\DocQrPresenter.cs" />
    <Compile Include="Presentation\Presenters\GiaoDbPresenter.cs" />
    <Compile Include="Presentation\Presenters\YmvnPresenter.cs" />
    <Compile Include="Modules\GiaoHangKhach\HVN\Controls\PhieuGridControl.cs" />
    <Compile Include="Modules\GiaoHangKhach\HVN\Controls\DocQrControl.cs" />
    <Compile Include="Modules\GiaoHangKhach\HVN\Controls\DocQrInputControl.cs" />
    <Compile Include="Modules\GiaoHangKhach\HVN\Controls\GiaoDbControl.cs" />
    <Compile Include="Modules\GiaoHangKhach\HVN\Controls\YmvnControl.cs" />
    <Compile Include="Modules\GiaoHangKhach\HVN\Controls\PhieuActionBarControl.cs" />
    <Compile Include="Modules\GiaoHangKhach\HVN\Controls\PhieuBottomStateControl.cs" />
    <Compile Include="Modules\GiaoHangKhach\HVN\Controls\PhieuDialogControl.cs" />
    <Compile Include="Modules\GiaoHangKhach\HVN\Controls\PhieuHeaderControl.cs" />
    <Compile Include="Modules\GiaoHangKhach\HVN\Controls\HangThieuControl.cs" />
    <Compile Include="Modules\GiaoHangKhach\HVN\HVN_PGH.PhieuGridMigration.cs" />

    <!-- Central stock boundary and transitional adapters. -->
    <Compile Include="Modules\KhoCore\Application\Contracts\Stock\IStockBalanceRepository.cs" />
    <Compile Include="Modules\KhoCore\Application\Contracts\Stock\IStockMovementService.cs" />
    <Compile Include="Modules\KhoCore\Application\Contracts\Stock\IStockSlotRepository.cs" />
    <Compile Include="Modules\KhoCore\Application\Contracts\Stock\IStockReceivingRepository.cs" />
    <Compile Include="Modules\KhoCore\Application\Services\StockMovementService.cs" />
    <Compile Include="Infrastructure\Stock\LegacyStockSlotRepositoryAdapter.cs" />
    <Compile Include="Modules\XuatKho\Application\Adapters\StockExportRepositoryAdapter.cs" />
    <Compile Include="Modules\XuLyHangLoi\Application\Adapters\ReworkStockBalanceAdapter.cs" />
    <Compile Include="Modules\XuLyHangLoi\Application\Adapters\ReworkStockSlotAdapter.cs" />
    <Compile Include="Modules\XuLyHangLoi\Application\XuLyHangLoiModuleFactory.cs" />
    <Compile Include="Modules\NhapKho\Application\Adapters\StockReceivingRepositoryAdapter.cs" />
  </ItemGroup>

  <PropertyGroup>
    <WarningLevel>4</WarningLevel>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <Target Name="ValidatePctpBuildBaseline" BeforeTargets="CoreCompile">
    <Error Condition="'$(TargetFrameworkVersion)' != 'v4.7.2'"
           Text="PCTP build baseline violation: TargetFrameworkVersion must remain v4.7.2 during the current migration." />
    <Error Condition="'$(LangVersion)' != '7.3'"
           Text="PCTP build baseline violation: LangVersion must remain 7.3 during the current migration." />
  </Target>
</Project>
