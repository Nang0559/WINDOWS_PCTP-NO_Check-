+        private static readonly System.Text.RegularExpressions.Regex DefectDocumentRef =
+            new System.Text.RegularExpressions.Regex(@"^XLBT#(\d+)$", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
+
+        /// <summary>
+        /// Dòng kho do xử lý hàng lỗi có MaPhieu dạng "XLBT#&lt;id&gt;" (id nội bộ, khó đọc). Bổ sung số phiếu thật:
+        /// "XLBT#12 (15-15-071126-2-1)" để đọc được trong lưới/timeline/Excel và tra theo số phiếu được.
+        /// Lỗi đọc (DB chưa có bảng xử lý hàng lỗi...) thì giữ nguyên số phiếu gốc.
+        /// </summary>
+        private void EnrichDefectDocuments(List<ItemHistoryRow> rows)
+        {
+            try
+            {
+                var ids = new HashSet<int>();
+                foreach (ItemHistoryRow r in rows)
+                {
+                    Match m;
+                    int id;
+                    if (TryParseDefectRef(r.DocumentNo, out m) && int.TryParse(m.Groups[1].Value, out id)) ids.Add(id);
+                }
+                if (ids.Count == 0) return;
+
+                var names = new Dictionary<int, string>();
+                foreach (DataRow d in LoadData("SELECT Id, SoPhieu FROM FVN_PhieuXuLyBatThuong WHERE Id IN (" + string.Join(",", ids) + ")").Rows)
+                    if (d["SoPhieu"] != DBNull.Value) names[Convert.ToInt32(d["Id"])] = Convert.ToString(d["SoPhieu"]);
+
+                foreach (ItemHistoryRow r in rows)
+                {
+                    Match m;
+                    int id;
+                    string soPhieu;
+                    if (TryParseDefectRef(r.DocumentNo, out m) && int.TryParse(m.Groups[1].Value, out id) && names.TryGetValue(id, out soPhieu))
+                        r.DocumentNo = r.DocumentNo.Trim() + " (" + soPhieu + ")";
+                }
+            }
+            catch (Exception)
+            {
+                // Không làm hỏng báo cáo vì phần bổ sung số phiếu.
+            }
+        }
+
+        private static bool TryParseDefectRef(string documentNo, out Match match)
+        {
+            match = DefectDocumentRef.Match((documentNo ?? string.Empty).Trim());
+            return match.Success;
+        }
