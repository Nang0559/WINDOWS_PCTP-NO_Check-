{
  "name": "g6-delivery-hvn-multilot",
  "purpose": "G6 real UI journey: seed run-scoped prerequisites, capture generated QR values without logging them, enter each QR through the real HVN_PGH control and Enter handler, assert delivery/QR/stock invariants, then cleanup.",
  "configured": true,
  "dataMutation": true,
  "scenario": {
    "id": "G6-005",
    "title": "Giao hang HVN 3 phieu 1/2/3 LOT",
    "description": "Seed 3 B20Item + 6 STOCKTP LOT + 3 TMPPHIEUGIAOHANG pending lines. QR values are generated from the seeded LOT and quantity and captured in memory only. The runner enters all six carton QR values into txt_DOCQRCODE and sends Enter, then asserts the real procedure's postconditions and cleans up the run prefix."
  },
  "testData": {
    "menuPath": "Giao Hàng > HVN - MP",
    "expectedWindowTitle": "HVN_PGH"
  },
  "steps": [
    {
      "id": "seed",
      "action": "sql-seed",
      "mutatesData": true,
      "sqlFile": "sql/delivery-hvn-multilot/seed.sql",
      "expectRowsAtLeast": 12,
      "description": "Seed 3 item, 6 STOCKTP lot va 3 dong TMPPHIEUGIAOHANG (1/2/3 LOT) voi tien to {{prefix}}",
      "captureColumns": [
        "SeedRowsAffected",
        "Qr1",
        "Qr2",
        "Qr3",
        "Qr4",
        "Qr5",
        "Qr6"
      ]
    },
    {
      "id": "expand-delivery-menu",
      "action": "expand",
      "automationId": "accordionControlElement22",
      "fallbackName": "Giao Hàng",
      "description": "Mở nhóm menu 'Giao Hàng'"
    },
    {
      "id": "open-hvn-delivery",
      "action": "click",
      "automationId": "E_GHHVN_MP",
      "waitAfterMs": 1200,
      "fallbackName": "HVN - MP",
      "description": "Chọn mục menu 'HVN - MP' ({{menuPath}})"
    },
    {
      "id": "delivery-screen-visible",
      "action": "wait-for-window",
      "value": "{{expectedWindowTitle}}",
      "timeoutSeconds": 45,
      "description": "Chờ màn hình đích xuất hiện",
      "expected": "Cửa sổ có tiêu đề '{{expectedWindowTitle}}' hiển thị",
      "dump": true
    },
    {
      "id": "verify-delivery-title",
      "action": "assert-window-title",
      "value": "{{expectedWindowTitle}}",
      "description": "Xác nhận tiêu đề cửa sổ"
    },
    {
      "id": "delivery-qr-input-exposed",
      "action": "assert-exists",
      "automationId": "txt_DOCQRCODE",
      "description": "Control 'txt_DOCQRCODE' phải tồn tại trên màn hình",
      "expected": "'txt_DOCQRCODE' hiển thị"
    },
    {
      "id": "delivery-order-grid-exposed",
      "action": "assert-exists",
      "automationId": "gridCtrDONHANG",
      "description": "Control 'gridCtrDONHANG' phải tồn tại trên màn hình",
      "expected": "'gridCtrDONHANG' hiển thị"
    },
    {
      "id": "enter-carton-qr-1",
      "action": "set-value",
      "automationId": "txt_DOCQRCODE",
      "value": "{{Qr1}}",
      "description": "Nhập QR tem thùng #1 được sinh từ LOT/quantity của run này vào ô quét thật",
      "waitAfterMs": 150
    },
    {
      "id": "submit-carton-qr-1",
      "action": "press-enter",
      "automationId": "txt_DOCQRCODE",
      "description": "Gửi QR tem thùng #1 qua event Enter của UI thật",
      "waitAfterMs": 350,
      "dump": true
    },
    {
      "id": "enter-carton-qr-2",
      "action": "set-value",
      "automationId": "txt_DOCQRCODE",
      "value": "{{Qr2}}",
      "description": "Nhập QR tem thùng #2 được sinh từ LOT/quantity của run này vào ô quét thật",
      "waitAfterMs": 150
    },
    {
      "id": "submit-carton-qr-2",
      "action": "press-enter",
      "automationId": "txt_DOCQRCODE",
      "description": "Gửi QR tem thùng #2 qua event Enter của UI thật",
      "waitAfterMs": 350,
      "dump": false
    },
    {
      "id": "enter-carton-qr-3",
      "action": "set-value",
      "automationId": "txt_DOCQRCODE",
      "value": "{{Qr3}}",
      "description": "Nhập QR tem thùng #3 được sinh từ LOT/quantity của run này vào ô quét thật",
      "waitAfterMs": 150
    },
    {
      "id": "submit-carton-qr-3",
      "action": "press-enter",
      "automationId": "txt_DOCQRCODE",
      "description": "Gửi QR tem thùng #3 qua event Enter của UI thật",
      "waitAfterMs": 350,
      "dump": false
    },
    {
      "id": "enter-carton-qr-4",
      "action": "set-value",
      "automationId": "txt_DOCQRCODE",
      "value": "{{Qr4}}",
      "description": "Nhập QR tem thùng #4 được sinh từ LOT/quantity của run này vào ô quét thật",
      "waitAfterMs": 150
    },
    {
      "id": "submit-carton-qr-4",
      "action": "press-enter",
      "automationId": "txt_DOCQRCODE",
      "description": "Gửi QR tem thùng #4 qua event Enter của UI thật",
      "waitAfterMs": 350,
      "dump": false
    },
    {
      "id": "enter-carton-qr-5",
      "action": "set-value",
      "automationId": "txt_DOCQRCODE",
      "value": "{{Qr5}}",
      "description": "Nhập QR tem thùng #5 được sinh từ LOT/quantity của run này vào ô quét thật",
      "waitAfterMs": 150
    },
    {
      "id": "submit-carton-qr-5",
      "action": "press-enter",
      "automationId": "txt_DOCQRCODE",
      "description": "Gửi QR tem thùng #5 qua event Enter của UI thật",
      "waitAfterMs": 350,
      "dump": false
    },
    {
      "id": "enter-carton-qr-6",
      "action": "set-value",
      "automationId": "txt_DOCQRCODE",
      "value": "{{Qr6}}",
      "description": "Nhập QR tem thùng #6 được sinh từ LOT/quantity của run này vào ô quét thật",
      "waitAfterMs": 150
    },
    {
      "id": "submit-carton-qr-6",
      "action": "press-enter",
      "automationId": "txt_DOCQRCODE",
      "description": "Gửi QR tem thùng #6 qua event Enter của UI thật",
      "waitAfterMs": 350,
      "dump": true
    },
    {
      "id": "assert-after-ui",
      "action": "sql-assert",
      "sqlFile": "sql/delivery-hvn-multilot/assert-after-scan.sql",
      "expectColumns": {
        "StockViolations": 0,
        "LuuOverIssued": 0,
        "QrWithoutStockViolations": 0,
        "LuuLots": 6,
        "LuuLotsWithQr": 6,
        "QrFccQty": 28,
        "StockIssued": 28,
        "QrDuplicateRows": 0
      },
      "description": "Sau 6 lần quét QR bằng ô UI thật, đối chiếu delivery/QR/stock và invariant; không seed kết quả nghiệp vụ."
    },
    {
      "id": "cleanup",
      "action": "sql-cleanup",
      "mutatesData": true,
      "sqlFile": "sql/delivery-hvn-multilot/cleanup.sql",
      "verifySqlFile": "sql/delivery-hvn-multilot/verify.sql",
      "description": "Xoa dung du lieu da seed va kiem tra khong con dong nao"
    }
  ]
}
