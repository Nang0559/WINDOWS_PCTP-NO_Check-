{
  "name": "g6-receive",
  "purpose": "G6 business journey (seed -> UI -> SQL assert -> cleanup). Extends receive-navigation.json.",
  "configured": true,
  "configurationNeeded": "",
  "dataMutation": true,
  "scenario": {
    "id": "G6-003",
    "title": "Nhap kho mot phieu seed",
    "description": "Tạo một dòng B30AccDoc riêng theo run, xác minh xuất hiện trong vNhapTP, tự điền QR tổng vào UI nhập kho, thực hiện nhập thật rồi kiểm tra STOCKTP/SlotLot/StockHistory/MovementGuard và cleanup."
  },
  "testData": {
    "menuPath": "Nhập Kho > Nhập thành phẩm - QR",
    "expectedWindowTitle": "Quản lý tiến trình Nhập kho"
  },
  "steps": [
    {
      "id": "seed",
      "action": "sql-seed",
      "mutatesData": true,
      "sqlFile": "sql/receive/seed.sql",
      "expectRowsAtLeast": 1,
      "captureColumns": [
        "SeedRowsAffected",
        "itemCode",
        "baseLot",
        "fullLot",
        "qr",
        "productionDate",
        "quantity"
      ],
      "description": "Tạo phiếu sản xuất riêng cho run {{prefix}} và lấy QR sinh từ dữ liệu SQL"
    },
    {
      "id": "expand-receive-menu",
      "action": "expand",
      "automationId": "NHAccordionControlElement",
      "fallbackName": "Nhập Kho",
      "description": "Mở nhóm menu Nhập Kho"
    },
    {
      "id": "open-receive-workflow",
      "action": "click",
      "automationId": "E_NhapTP",
      "waitAfterMs": 1200,
      "fallbackName": "Nhập thành phẩm - QR",
      "description": "Mở màn hình nhập kho"
    },
    {
      "id": "receiving-screen-visible",
      "action": "wait-for-window",
      "value": "{{expectedWindowTitle}}",
      "timeoutSeconds": 45,
      "description": "Chờ màn hình tiến trình nhập kho",
      "expected": "Màn hình tiến trình nhập kho hiển thị",
      "dump": true
    },
    {
      "id": "open-qr-scan",
      "action": "click",
      "automationId": "receive_btnScan",
      "waitAfterMs": 800,
      "fallbackName": "Quét nhập",
      "description": "Mở màn hình nhập QR"
    },
    {
      "id": "qr-entry-screen-visible",
      "action": "wait-for-window",
      "value": "NHẬP KHO HÀNG HÓA",
      "timeoutSeconds": 30,
      "description": "Chờ form quét QR tổng",
      "expected": "Form nhập QR tổng hiển thị",
      "dump": true
    },
    {
      "id": "fill-receiving-qr",
      "action": "set-value",
      "automationId": "receive_qrInput",
      "value": "{{qr}}",
      "description": "Tự điền QR tổng do bước seed sinh ra"
    },
    {
      "id": "submit-receiving-qr",
      "action": "press-enter",
      "automationId": "receive_qrInput",
      "waitAfterMs": 1200,
      "description": "Kích hoạt luồng quét QR thật; chế độ nhập hàng loạt tự lưu vào Slot ảo"
    },
    {
      "id": "receiving-success-visible",
      "action": "assert-name-contains",
      "automationId": "receive_bulkStatus",
      "value": "Đã nhập LOT",
      "description": "Xác nhận UI báo nhập kho thành công",
      "expected": "Thông báo thành công có LOT"
    },
    {
      "id": "assert-after-ui",
      "action": "sql-assert",
      "sqlFile": "sql/receive/assert.sql",
      "expectColumns": {
        "SourceRows": 1,
        "StockRows": 1,
        "SlotLotRows": 1,
        "ImportHistoryRows": 1,
        "ReceivedQty": 8,
        "RemainingQty": 8,
        "MovementGuardRows": 1
      },
      "description": "Xác minh giao dịch nhập kho đã commit trong DB57"
    },
    {
      "id": "cleanup",
      "action": "sql-cleanup",
      "mutatesData": true,
      "sqlFile": "sql/receive/cleanup.sql",
      "verifySqlFile": "sql/receive/verify.sql",
      "description": "Dọn riêng dữ liệu do run này tạo và xác minh Remaining=0"
    }
  ]
}
